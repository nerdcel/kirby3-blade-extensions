{
  "name": "nerdcel/kirby3-blade-extensions",
  "description": "Kirby3 plugin to add directives and ifs to blade.",
  "license": "MIT",
  "type": "kirby-plugin",
  "keywords": [
    "kirby3",
    "kirby-cms",
    "kirby-plugin",
    "getkirby",
    "kirby"
  ],
  "homepage": "https://github.com/nerdcel/kirby3-blade-extensions",
  "authors": [
    {
      "name": "Marcel Hieke",
      "email": "office@marcelhieke.com"
    }
  ],
  "require": {
    "php": ">= 8.1 < 8.4",
    "illuminate/view": "^v12.19.3",
    "illuminate/config": "^v12.19.3",
    "matthiasmullie/minify": "^1.3.75",
    "getkirby/composer-installer": "^1.2.1"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Nerdcel\\BladeExtensions\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "installer-name": "kirby3-blade-extensions"
  }
}
